# Build / cache artifacts
*.db-journal
*.log

# Runtime databases — regenerable state, not source (双轨协作前置改动)
#   corpus.db    宪法第二条：5 秒可重建（scripts/build_index.py），随便重建
#   knowledge.db 研究线程/偏好/收藏，运行期状态
#   history.db   查询历史，运行期状态
# 曾被 git 跟踪，导致两条轨道各跑一次测试就双方 working tree 脏、
# merge 时二进制冲突无法解决。改为忽略；重建命令见 constitution.md §IV。
data/history.db
data/knowledge.db
data/index/corpus.db
data/index/knowledge.db
data/index/history.db

# logs/ — runtime logs, screenshots, scratch probes (not deliverables)
logs/
# P2 scratch: downloaded git repos (82MB), not source we own
logs/p2_tmp/

# Local secrets — never commit the filled-in LLM config
llm_config.json
web/llm_config.json

# OS junk
Thumbs.db
desktop.ini
.DS_Store
node_modules/

# R230n（R26-P1）：SQLite WAL/SHM 边车 + R230i 腐库检疫产物——
# 运行期二进制，git add -A 会把腐库收回去（当年 corpus.db 事故同款）。
data/index/*.db-wal
data/index/*.db-shm
data/*.db-wal
data/*.db-shm
*.corrupt-*

# Temp probes (scratch files, not deliverables)
temp_*.py

# IDE
.vscode/
.idea/

# PyInstaller build output (217MB exe, not source)
dist/
build/
*.spec.bak

